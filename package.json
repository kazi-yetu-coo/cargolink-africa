    "@supabase/supabase-js": "2.118.0",
    "lucide-react": "1.61.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router-dom": "7.18.4"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.11",
